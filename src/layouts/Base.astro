---
import '../styles/global.css';
import { site } from '../data/site';
import Lightbox from '../components/Lightbox.astro';
import CursorBadge from '../components/CursorBadge.astro';
import Assistant from '../components/Assistant.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** home — главная, case — страница кейса (разная мобильная вёрстка) */
  kind: 'home' | 'case';
}
const { title, description = site.description, image = site.ogImage, kind } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(image, Astro.site).href : image;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {image === site.ogImage && <meta property="og:image:width" content="1200" />}
    {image === site.ogImage && <meta property="og:image:height" content="630" />}
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600&family=Caveat:wght@500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div style="font-family: Onest, system-ui, sans-serif; color: #111111; background: #FFFFFF; min-height: 100vh; font-size: 15px">
      <div
        class:list={['shell', kind]}
        style="max-width: 1160px; margin: 0 auto; padding: 40px 24px; display: flex; flex-wrap: wrap; gap: 48px 120px; align-items: flex-start"
      >
        <slot />
      </div>
    </div>
    <Lightbox />
    <CursorBadge />
    <Assistant />
  </body>
</html>
