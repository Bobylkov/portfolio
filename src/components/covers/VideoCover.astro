---
import CoverFrame from './CoverFrame.astro';

interface Props {
  href?: string;
  src: string;
  poster?: string;
  alt: string;
}
const { href, src, poster, alt } = Astro.props;
---
<CoverFrame href={href} style="display: block; aspect-ratio: 16 / 10; background: #F4F4F2; border-radius: 24px; overflow: hidden; text-decoration: none">
  <video src={src} poster={poster} autoplay muted loop playsinline preload="metadata" aria-label={alt} style="display: block; width: 100%; height: 100%; object-fit: cover"></video>
</CoverFrame>
