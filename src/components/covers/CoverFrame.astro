---
// Обёртка обложки: ссылка на кейс или просто блок, если страницы ещё нет
interface Props {
  href?: string;
  style: string;
}
const { href, style } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag class="cover" href={href} style={style} data-cursor={href ? 'Смотреть кейс →' : undefined}><slot /></Tag>
