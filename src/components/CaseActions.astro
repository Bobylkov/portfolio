---
// Кнопки под карточкой кейса: чёрная пилюля «Читать кейс →» и доп. ссылки
interface Props {
  href?: string;
  cta: string;
  links?: { label: string; href: string }[];
  draft?: boolean;
}
const { href, cta, links, draft } = Astro.props;
const label = cta.replace(/\s*→\s*$/, '');
const hasArrow = /→\s*$/.test(cta);
---
<div class="case-actions">
  {draft || !href ? (
    <span style="font-weight: 500; color: #8A8A86">{cta}</span>
  ) : (
    <a class="cta-pill" href={href} data-label={cta}>{label}{hasArrow && <span class="cta-arrow" aria-hidden="true">→</span>}</a>
  )}
  {links?.map((l) => <a class="cta-link" href={l.href}>{l.label}</a>)}
</div>
