---
// Прячет подсказку «Листайте внутри» у мокапа, как только его прокрутили
---
<script>
  document.querySelectorAll<HTMLElement>('.dev .dev-scroll').forEach((el) => {
    const dev = el.closest('.dev');
    const onScroll = () => {
      if (el.scrollTop > 24) { dev?.classList.add('scrolled'); el.removeEventListener('scroll', onScroll); }
    };
    el.addEventListener('scroll', onScroll, { passive: true });
  });
</script>
