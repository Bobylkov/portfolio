---
// Карточка кейса в ленте на главной
import { imageSize } from '../lib/html';
import { caseUrl, iconOf, type Case, type Company } from '../lib/content';
import Cover from './covers/Cover.astro';
import MetaLine from './MetaLine.astro';
import Nums from './Nums.astro';

interface Props {
  entry: Case;
  companies: Company[];
}
const { entry, companies } = Astro.props;
const { card, draft } = entry.data;
const href = draft ? undefined : caseUrl(entry);
const icon = iconOf(entry, companies);
const thumbSize = card.layout === 'compact' && card.cover.kind === 'image' ? await imageSize(card.cover.src) : null;
---
{card.layout === 'compact' && card.cover.kind === 'image' ? (
  <article id={`case-${entry.id}`} style="display: flex; gap: 20px; align-items: center; flex-wrap: wrap; margin-top: -24px">
    <a class="ds-thumb" href={href} data-cursor="Смотреть кейс →" style="flex: 0 0 240px; display: block; border-radius: 18px; overflow: hidden; text-decoration: none">
      <img src={card.cover.src} alt={card.cover.alt} width={thumbSize?.width} height={thumbSize?.height} loading="lazy" decoding="async" style="display: block; width: 100%; height: auto" />
    </a>
    <div style="flex: 1 1 280px; min-width: 0; display: flex; flex-direction: column; gap: 8px">
      <span style="font-size: 13px; color: #8A8A86">{card.meta}</span>
      <a href={href} style="font-size: 18px; line-height: 1.3; font-weight: 600; text-decoration: none" set:html={card.title} />
      <p style="margin: 0; line-height: 1.5; color: #444444; font-size: 14px" set:html={card.lead} />
    </div>
  </article>
) : (
  <article id={`case-${entry.id}`} style="display: flex; flex-direction: column; gap: 18px">
    <Cover cover={card.cover} href={href} />
    <MetaLine icon={icon.src} border={icon.border} text={card.meta} />
    <h2 style="margin: 0; font-size: 24px; line-height: 1.25; font-weight: 600; letter-spacing: -0.01em">
      {href ? <a href={href} set:html={card.title} /> : <Fragment set:html={card.title} />}
    </h2>
    <p style="margin: 0; line-height: 1.55; color: #444444; max-width: 620px" set:html={card.lead} />
    {card.nums && <Nums items={card.nums} />}
    {card.images && (
      <div class="pair">
        {card.images.map((img) => (
          <img src={img.src} alt={img.alt} loading="lazy" decoding="async" style="display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 20px; background: #F4F4F2" />
        ))}
      </div>
    )}
    {draft ? (
      <span style="font-weight: 500; color: #8A8A86">{card.cta}</span>
    ) : card.links ? (
      <div style="display: flex; flex-wrap: wrap; gap: 8px 20px; font-weight: 500">
        <a href={href} style="text-decoration: none">{card.cta}</a>
        {card.links.map((l) => <a href={l.href} style="text-decoration: none; color: #6B6B6B">{l.label}</a>)}
      </div>
    ) : (
      <a href={href} style="text-decoration: none; font-weight: 500">{card.cta}</a>
    )}
  </article>
)}
