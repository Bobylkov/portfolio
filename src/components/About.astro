---
// «Кое-что обо мне» и ссылка на плейлист с вращающейся пластинкой (анимация .vinyl — в global.css)
import { site } from '../data/site';
---
<section id="about" style="display: flex; flex-direction: column; gap: 20px; max-width: 560px">
  <h2 style="margin: 0; font-size: 17px; font-weight: 600">Кое-что обо мне</h2>
  <div style="display: flex; flex-direction: column; gap: 4px"><span style="font-weight: 600">✦ Ищу баланс бизнеса и пользователя</span><span style="line-height: 1.5; color: #444444">Метрика растёт, когда человеку спокойно: без давления и лишней рекламы.</span></div>
  <div style="display: flex; flex-direction: column; gap: 4px"><span style="font-weight: 600">✦ Проверяю решения на людях</span><span style="line-height: 1.5; color: #444444">Интервью и юзабилити-тесты с исследователями, после запуска — метрики.</span></div>
  <div style="display: flex; flex-direction: column; gap: 4px"><span style="font-weight: 600">✦ Масштабирую через дизайн-систему</span><span style="line-height: 1.5; color: #444444">Удачные решения превращаю в компоненты с правилами.</span></div>
  <div style="display: flex; flex-direction: column; gap: 4px"><span style="font-weight: 600">✦ Веду кросс-командные проекты</span><span style="line-height: 1.5; color: #444444">Продукт, исследования, разработка, иллюстрация — довожу до прода.</span></div>
  <a href={site.playlist} aria-label="Плейлист в Яндекс Музыке" style="display: flex; align-items: center; gap: 10px; margin-top: 4px; padding: 10px 18px 10px 10px; border-radius: 999px; background: #FFF8DC; text-decoration: none">
    <span aria-hidden="true" style="position: relative; flex: 0 0 auto; width: 34px; height: 34px"><svg class="vinyl" width="30" height="30" viewBox="0 0 40 40" style="position: absolute; left: 0; top: 2px; display: block"><circle cx="20" cy="20" r="19.5" fill="#111111"></circle><circle cx="20" cy="20" r="16" fill="none" stroke="#2E2E2E" stroke-width="0.8"></circle><circle cx="20" cy="20" r="13" fill="none" stroke="#2E2E2E" stroke-width="0.8"></circle><circle cx="20" cy="20" r="10.5" fill="none" stroke="#2E2E2E" stroke-width="0.8"></circle><path d="M8 12a14 14 0 0 1 9-5.5" fill="none" stroke="#FFFFFF" stroke-opacity="0.35" stroke-width="1.6" stroke-linecap="round"></path><path d="M32 28a14 14 0 0 1-9 5.5" fill="none" stroke="#FFFFFF" stroke-opacity="0.18" stroke-width="1.6" stroke-linecap="round"></path><circle cx="20" cy="20" r="7" fill="#FFCC00"></circle><path d="M17 18.2a3.4 3.4 0 0 1 4.6-1.6" fill="none" stroke="#111111" stroke-opacity="0.35" stroke-width="1" stroke-linecap="round"></path><circle cx="20" cy="20" r="1.4" fill="#FFF8DC"></circle></svg><svg width="16" height="22" viewBox="0 0 16 22" style="position: absolute; right: -2px; top: -2px; display: block"><circle cx="12" cy="3.5" r="2.6" fill="#8A8A86"></circle><path d="M12 3.5 L12.5 14 L7.5 18.5" fill="none" stroke="#8A8A86" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path><rect x="4.6" y="16.6" width="4.4" height="3.2" rx="0.8" transform="rotate(-40 6.8 18.2)" fill="#C9C9C4"></rect></svg></span><span style="flex: 1; min-width: 0">Плейлист, под который дизайню</span><span class="pl-src" style="flex: 0 0 auto; font-size: 13px; color: #8A8A86; white-space: nowrap">Яндекс Музыка ↗</span></a>
</section>
