---
// Глебашкин — ассистент Глеба: плавающая ИИ-искорка, по клику открывается чат
// с готовыми вопросами. Ответы написаны заранее по кейсам и CV (без модели).
// Свой вопрос разбирает src/lib/assistant-search.ts: тема и сторона кейса, похожие формулировки, поиск по текстам кейсов.
// База знаний — src/data/assistant.ts. Ассистент помнит тему разговора: «а метрики какие?» — про последний кейс.
import { site } from '../data/site';
import { answers } from '../data/assistant';
---
<div class="asst" data-telegram={site.telegram}>
  <div class="asst-bubble" hidden>
    <span>Привет! Спроси меня про кейсы</span>
    <button type="button" class="asst-bubble-x" aria-label="Скрыть подсказку">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
  </div>

  <button type="button" class="asst-launch" aria-label="Открыть чат с Глебашкиным, ассистентом Глеба" aria-expanded="false" aria-controls="asst-panel">
    <svg class="asst-face" viewBox="0 0 120 120" aria-hidden="true">
      <g class="asst-spark"><path d="M97 17 L97 28 M91.5 22.5 L102.5 22.5" stroke="#111" stroke-width="3.8" stroke-linecap="round"></path></g>
      <g class="asst-spark asst-spark-2"><path d="M20 90 L20 98 M16 94 L24 94" stroke="#111" stroke-width="3.4" stroke-linecap="round"></path></g>
      <g class="asst-head">
        <path d="M60 8 C 64 40, 80 56, 112 60 C 80 64, 64 80, 60 112 C 56 80, 40 64, 8 60 C 40 56, 56 40, 60 8 Z" fill="#1C4FD8" stroke="#111" stroke-width="4" stroke-linejoin="round"></path>
        <g class="asst-eyes" fill="#FFFFFF"><circle cx="51" cy="57" r="4.4"></circle><circle cx="69" cy="57" r="4.4"></circle></g>
        <path d="M52.5 68 C 56.5 72.5, 63.5 72.5, 67.5 68" fill="none" stroke="#FFFFFF" stroke-width="3.8" stroke-linecap="round"></path>
        <g fill="#FF8FA3" opacity=".9"><ellipse cx="44" cy="66" rx="3.6" ry="2.2"></ellipse><ellipse cx="76" cy="66" rx="3.6" ry="2.2"></ellipse></g>
      </g>
    </svg>
  </button>

  <section class="asst-panel" id="asst-panel" role="dialog" aria-label="Чат с Глебашкиным, ассистентом Глеба" hidden>
    <header class="asst-head-bar">
      <span class="asst-mini" aria-hidden="true">
        <svg viewBox="0 0 120 120"><circle cx="60" cy="60" r="58" fill="#EEF2FD"></circle><path d="M60 16 C 63 42, 76 55, 104 60 C 76 65, 63 78, 60 104 C 57 78, 44 65, 16 60 C 44 55, 57 42, 60 16 Z" fill="#1C4FD8" stroke="#111" stroke-width="4.5" stroke-linejoin="round"></path><circle cx="52" cy="57" r="4.4" fill="#fff"></circle><circle cx="68" cy="57" r="4.4" fill="#fff"></circle><path d="M53.5 67 C 57 71, 63 71, 66.5 67" fill="none" stroke="#fff" stroke-width="3.8" stroke-linecap="round"></path></svg>
      </span>
      <span class="asst-title"><b>Глебашкин</b><span>Отвечаю по кейсам и CV</span></span>
      <button type="button" class="asst-close" aria-label="Закрыть чат">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </header>
    <div class="asst-log" aria-live="polite"></div>
    <div class="asst-chips">
      {answers.filter((a) => a.chip).map((a) => <button type="button" class="asst-chip" data-id={a.id}>{a.q}</button>)}
    </div>
    <form class="asst-form">
      <label class="sr-only" for="asst-input">Ваш вопрос</label>
      <input id="asst-input" class="asst-input" type="text" placeholder="Спросите про опыт или кейсы" autocomplete="off" maxlength="300" />
      <button type="submit" class="asst-send" aria-label="Отправить">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </button>
    </form>
  </section>
</div>

<script>
  import { kb } from '../data/assistant';
  import { buildBrain, buildIndex, replyFor, respond, type Answer, type Reply, type SearchIndex, type State } from '../lib/assistant-search';
  const root = document.querySelector<HTMLElement>('.asst');
  if (root) {
    const answers = kb.answers;
    const brain = buildBrain(kb);
    const launch = root.querySelector<HTMLButtonElement>('.asst-launch')!;
    const panel = root.querySelector<HTMLElement>('.asst-panel')!;
    const log = root.querySelector<HTMLElement>('.asst-log')!;
    const form = root.querySelector<HTMLFormElement>('.asst-form')!;
    const input = root.querySelector<HTMLInputElement>('.asst-input')!;
    const bubble = root.querySelector<HTMLElement>('.asst-bubble')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const tg = root.dataset.telegram || '#';
    let greeted = false;
    // память разговора: тема последнего ответа и уже заданные вопросы
    const state: State = { topic: undefined, asked: [] };

    // тексты кейсов для поиска: грузятся один раз, при первом открытии чата
    let indexPromise: Promise<SearchIndex | undefined> | undefined;
    const loadIndex = () =>
      (indexPromise ??= fetch('/assistant-index.json')
        .then((r) => (r.ok ? r.json() : []))
        .then(buildIndex)
        .catch(() => undefined));

    const store = (k: string, v?: string) => {
      try { if (v === undefined) return sessionStorage.getItem(k); sessionStorage.setItem(k, v); } catch { /* приватный режим */ }
      return null;
    };

    // подсказка рядом с персонажем — один раз за визит
    if (!store('asst-bubble')) {
      window.setTimeout(() => { if (panel.hidden) bubble.hidden = false; }, 3500);
    }
    const hideBubble = () => { bubble.hidden = true; store('asst-bubble', '1'); };
    root.querySelector('.asst-bubble-x')?.addEventListener('click', hideBubble);

    const scrollDown = () => { log.scrollTop = log.scrollHeight; };
    const add = (who: 'bot' | 'me', html: string) => {
      const m = document.createElement('div');
      m.className = `asst-msg asst-${who}`;
      if (who === 'me') m.textContent = html; else m.innerHTML = html;
      log.appendChild(m);
      scrollDown();
      return m;
    };
    // кнопки «спросить ещё» под ответом
    const suggest = (ids: string[]) => {
      log.querySelectorAll('.asst-sugg').forEach((el) => el.remove());
      const items = ids.map((id) => answers.find((x) => x.id === id)).filter((x): x is Answer => !!x);
      if (!items.length) return;
      const row = document.createElement('div');
      row.className = 'asst-sugg';
      for (const a of items) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'asst-chip';
        b.textContent = a.q;
        b.addEventListener('click', () => ask(a.q, a));
        row.appendChild(b);
      }
      log.appendChild(row);
      scrollDown();
    };

    const reply = (html: string, next: string[] = []) => {
      const typing = add('bot', '<span class="asst-dots"><i></i><i></i><i></i></span>');
      typing.classList.add('asst-typing');
      window.setTimeout(() => {
        typing.classList.remove('asst-typing');
        typing.innerHTML = html;
        scrollDown();
        suggest(next);
      }, reduce ? 0 : 650);
    };

    const ask = async (q: string, a?: Answer) => {
      log.querySelectorAll('.asst-sugg').forEach((el) => el.remove());
      add('me', q);
      const r: Reply = a ? replyFor(a, kb, state) : respond(q, brain, await loadIndex(), state);
      if (r.id && r.id !== 'more') state.asked.push(r.id);
      // тема держится, пока не заговорили о другом кейсе: после «а зарплата?» можно вернуться к «а метрики?»
      state.topic = r.topic ?? state.topic;
      if (r.via === 'none') {
        reply(`Не нашёл ответа ни в готовых вопросах, ни в кейсах. Попробуйте спросить иначе или выберите вопрос ниже. А обсудить что-то своё лучше с Глебом — <a href="${tg}" target="_blank" rel="noopener">напишите ему в Telegram</a>.`, r.suggest);
      } else reply(r.html, r.suggest);
    };

    const open = () => {
      panel.hidden = false;
      launch.setAttribute('aria-expanded', 'true');
      root.classList.add('is-open');
      hideBubble();
      loadIndex();
      if (!greeted) {
        greeted = true;
        reply('Привет! Я Глебашкин, ассистент Глеба. Расскажу про его опыт и кейсы — выберите вопрос или напишите свой.');
      }
      window.setTimeout(() => input.focus({ preventScroll: true }), 50);
    };
    const close = () => {
      panel.hidden = true;
      launch.setAttribute('aria-expanded', 'false');
      root.classList.remove('is-open');
      launch.focus({ preventScroll: true });
    };

    launch.addEventListener('click', () => (panel.hidden ? open() : close()));
    root.querySelector('.asst-close')?.addEventListener('click', close);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) close(); });
    root.querySelectorAll<HTMLButtonElement>('.asst-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const a = answers.find((x) => x.id === chip.dataset.id);
        if (a) ask(a.q, a);
      });
    });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = input.value.trim();
      if (!q) return;
      input.value = '';
      ask(q);
    });
  }
</script>
