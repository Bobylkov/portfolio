---
interface Props {
  src: string;
  size: 16 | 20 | 36;
  border?: boolean;
  alt?: string;
}
const { src, size, border = false, alt = '' } = Astro.props;
const radius = { 16: 4, 20: 6, 36: 10 }[size];
const style = [
  'flex: 0 0 auto',
  'display: block',
  `width: ${size}px`,
  `height: ${size}px`,
  `border-radius: ${radius}px`,
  border && 'border: 1px solid #E4E4DF',
  border && 'box-sizing: border-box',
  'object-fit: cover',
  'background: #FFFFFF',
]
  .filter(Boolean)
  .join('; ');
---
<img src={src} alt={alt} width={size} height={size} style={style} />
